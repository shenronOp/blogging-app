<!DOCTYPE html>
<html lang="en">

<head>
    <%- include('./partials/head') %>
    <title>HomePage</title>
    <style>
        .blog-image {
            float: left;
            margin: 0 20px 20px 0; /* space around the image */
            max-width: 40%; /* adjust image width */
            height: auto;
        }

        .author-info {
            display: flex;
            align-items: center;
            margin-top: 20px;
            clear: both; /* ensures author info is below floated content */
        }

        .author-info img {
            border-radius: 50%;
            margin-right: 10px;
        }
    </style>
</head>

<body>
    <%- include('./partials/nav') %>

    <div class="container mt-4">
        <h1><%= blog.title %></h1>

        <!-- Blog image floated -->
        <img src="<%= blog.coverImageURL %>" alt="Blog Cover" class="blog-image img-fluid img-thumbnail">

        <!-- Blog body wraps around the image -->
        <div><%= blog.body %></div>

        <!-- Author info below content -->
        <div class="author-info">
            <img src="<%= blog.createdBy.profileImageURL %>" alt="Author" width="50px">
            <span><%= blog.createdBy.fullName %></span>
        </div>
    </div>

    
    

    <div class="container mt-3">
        <h1>Comments (<%=comments.length%>):</h1>
        <% if (locals.user) { %>
            <form method="post" action="/blog/comment/<%=blog._id%>">
            <div class="mb-3">
                <input type="text" class="form-control" id="exampleInputEmail1" aria-describedby="emailHelp"
                    name="content" placeholder="Enter your comment">
            </div>
            <button type="submit" class="btn btn-primary">Submit</button>
            </form>
        <% } %>
    </div>

    <div class="container mt-4">
        <% comments.forEach(comment => { %>
            <div><img src="<%= comment.createdBy.profileImageURL %>" alt="Author" width="50px">
                <%= comment.createdBy.fullName %>
            <div><%=comment.content%></div>
        <% }) %>
    </div>

    <%- include('./partials/script') %>
</body>

</html>
